APP_NAME=NexAbility API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./nexability_dev.db
SECRET_KEY=replace-with-a-local-development-secret

# ML Matching Service URL (the standalone FastAPI ML service)
# Set this to wherever the ML service is running
ML_SERVICE_URL=http://localhost:8001

# Internal service key shared between backend and ML service
# Must match NEXABILITY_INTERNAL_ML_API_KEY in ml/.env
INTERNAL_ML_API_KEY=ml-internal-secret-token
